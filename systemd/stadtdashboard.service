[Unit]
Description=StadtDashboard – lokale Digital-Signage-Plattform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stadtdashboard
Group=stadtdashboard
WorkingDirectory=/opt/stadtdashboard
ExecStart=/opt/stadtdashboard/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=SB_DATA_DIR=/opt/stadtdashboard/data

# Bewusst KEIN ProtectSystem/ReadWritePaths/ProtectHome: Diese Mount-Namespace-
# Härtung laeuft in unprivilegierten LXC-Containern nicht zuverlaessig (sqlite-
# Fehler 'unable to open database file'). Schutz bleibt ueber dedizierten
# System-Benutzer + NoNewPrivileges gegeben.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
