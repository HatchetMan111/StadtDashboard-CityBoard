[Unit]
Description=StadtDashboard – lokale Digital-Signage-Plattform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stadtdashboard
Group=stadtdashboard
WorkingDirectory=/opt/stadtdashboard
ExecStart=/opt/stadtdashboard/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=SB_DATA_DIR=/opt/stadtdashboard/data

# Harte Absicherung: nur Schreibzugriff auf das Datenverzeichnis
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/stadtdashboard/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
